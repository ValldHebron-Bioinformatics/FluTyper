manifest {
  name = 'FluTyper'
  contributors = [
    [name: "Marc Pérez-Bautista",contribution:['author','maintainer'],email:'marc.perez.bautista@vhir.org'],
    [name: "Alejandra González-Sánchez",contribution:['contributor']]
  ]
  homePage = 'https://github.com/[UPDATE]'
  description = 'Pipeline for Influenza genotyping and analysis'
  mainScript = 'main.nf'
}
params {
  help = null
  version = "1.1.0"
  protocol = "AVIAN" // Default protocol
  protocols = [
    AVIAN: [
      directory : "${projectDir}/../protocols/AVIAN",
      resources : "${projectDir}/../protocols/AVIAN/v1"      
    ],
    SWINE: [
      directory : "${projectDir}/../protocols/SWINE",
      resources : "${projectDir}/../protocols/SWINE/v1"      
    ],
    HUMAN: [
      directory : "${projectDir}/../protocols/HUMAN",
      resources : "${projectDir}/../protocols/HUMAN/v2"      
    ]
  ]
  segments = ["HA","NA","PB2","PB1","PA","NP","MP","NS"]
  extraMarkers = null
  inputFasta = "${projectDir}/../docs/fastas/cresaid.fasta" // Default inputFasta
  outDir = "RESULTS"
  threshold = 0.25 // Default threshold, can be overridden with --threshold
  colorblind = false // Whether to use colorblind-friendly palettes in reports, can be set with --colorblind
  metadata = null // Path to metadata file, can be set with --metadata
  IndividualReports = false // Whether to generate individual reports for each sample, can be set with --IndividualReports
  append = null // Whether to append results to existing output, can be set with --append
  coordinates = "${projectDir}/../RESOURCES/coordenades_cat.tsv" // Path to coordinates file, can be set with --coordinates
  carto_api_key = null // CARTO Maps API key for basemap tiles, set with --carto_api_key

  // Phylogenetics module (optional, HUMAN protocol, H3N2 and H1N1pdm09). Kebab-case also works on the command line
  // (--aa-positions = --aaPositions)
  phylogenetics = false // Build the annotated whole-genome phylogeny, set with --phylogenetics
  phyloSubtype = "H3N2,H1N1pdm09" // Comma-separated subtypes whose samples get their own tree (H3N2, H1N1pdm09)
  // Per-subtype reference / fallback / root strains / outgroup. phyloReference, phyloReferenceFallback,
  // phyloRootStrains and phyloOutgroup below remain H3N2 overrides for backward compatibility: a value given
  // there always wins over phyloSubtypeConfig.H3N2 (see resolvePhyloConfig() in subworkflows/Phylogenetics.nf).
  phyloSubtypeConfig = [
    H3N2: [reference: "A/Darwin/6/2021", referenceFallback: "A/Massachusetts/18/2022",
           rootStrains: "A/Darwin/6/2021,A/Massachusetts/18/2022,A/Croatia/10136RV/2023,A/Singapore/GP20238/2024,A/Sydney/1359/2024",
           outgroup: "A/Darwin/6/2021"],
    H1N1pdm09: [reference: "A/Wisconsin/67/2022", referenceFallback: "A/Wisconsin/67/2022",
           rootStrains: "A/Victoria/2570/2019,A/Sydney/5/2021,A/Wisconsin/67/2022",
           outgroup: "A/Victoria/2570/2019"]
  ]
  phyloReference = "A/Darwin/6/2021" // H3N2 override: alignment coordinate reference
  phyloReferenceFallback = "A/Massachusetts/18/2022" // H3N2 override: coordinate reference for segments missing from phyloReference (PA)
  phyloRootStrains = "A/Darwin/6/2021,A/Massachusetts/18/2022,A/Croatia/10136RV/2023,A/Singapore/GP20238/2024,A/Sydney/1359/2024" // H3N2 override: WHO reference / vaccine strains added as tips
  phyloOutgroup = "A/Darwin/6/2021" // H3N2 override: root strain used as the outgroup to root the tree
  phyloSegmentOrder = "PB2,PB1,PA,HA,NP,NA,MP,NS" // Segment order of the concatenated alignment
  phyloWholeGenome = false // Also build the whole-genome tree (Koumaty et al. 2026); off by default, segment trees are the main output
  phyloSegmentTrees = "all" // Segment trees to build: "all", "none", or a comma-separated subset of phyloSegmentOrder's segments
  phyloMinCoverage = 0.95 // Minimum coverage required in every segment for a sample to enter the phylogeny
  model = "GTR+G4" // IQ-TREE substitution model
  bootstrap = 1000 // IQ-TREE ultrafast bootstrap replicates (0 = none, otherwise >= 1000)
  seed = 12345 // Random seed for IQ-TREE
  clusterThreshold = 0.005 // TreeCluster single-linkage threshold (substitutions per site)
  minSupportLabel = 70 // Minimum ultrafast bootstrap support (%) drawn as a node label on the tree; 0 shows all
  aaPositions = "HA1:62,HA1:145,HA1:239" // H3N2 amino acid positions shown as heatmap columns (Koumaty et al. 2026)
  aaPositionsH1n1 = null // H1N1pdm09 amino acid positions shown as heatmap columns, e.g. HA1:62,HA1:145,239 (no default: the paper is H3N2-only)
  aaPositionsFile = null // CSV (protein,position[,subtype]) of amino acid positions; overrides aaPositions/aaPositionsH1n1 for the subtypes it covers
  aaGene = "HA1" // Gene used for bare positions in aaPositions / aaPositionsH1n1
  minPanelCoverage = 0.8 // Minimum fraction of samples with data for the source and period panels to be drawn
  labMap = null // TSV ORIGINATING_LAB<TAB>display_group to group originating labs in the source panel
  periodBin = "month" // Period panel binning: month, week or none
  width = 12 // Figure width (inches)
  height = 10 // Figure height (inches)
  dpi = 300 // PNG resolution
  phyloPanels = "${projectDir}/../RESOURCES/phylo_panels.tsv" // Declarative panel spec of the phylogeny figure
  phyloTools = [ // Expected versions (FluTyper_env.yaml) checked before the module runs
    "mafft": "7.525", "iqtree2": "2.3.6", "treetime": "0.11.4", "TreeCluster.py": "1.0.4", "nextclade": "3.18.0",
    "Rscript": "4.5.3", "ggtree": "4.0.5", "ape": "5.8.1", "ggplot2": "4.0.3", "ggnewscale": "0.5.2", "svglite": "2.2.2"
  ]
}

// Local execution configuration
executor {
  name = 'local'
  cpus = 18        // Use 18 threads, leave 2 for the operating system
  memory = 13.GB // Strictly limit total Nextflow RAM to prevent OS crashing
}

process {
  cpus = 1
  memory = 2.GB

  withLabel: 'big_mem' {
    cpus = 12        
    memory = 10.GB  
    maxForks = 1      
  }
}
profiles {
  ci {
    process {
      // Catch-all for standard processes
      cpus = 1
      memory = 4.GB
      maxRetries = 1
      
      withLabel: 'big_mem' {
        cpus = 2
        memory = 6.GB
        maxForks = 1
      }
    }
  }
}



