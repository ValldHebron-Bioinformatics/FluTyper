/*
 * Conda scope, shared by nf_pipeline/nextflow.config (pipeline runs, pipeline nf-tests) and tests/nextflow.config
 * (module / workflow nf-tests, which do not load nf_pipeline/nextflow.config).
 *
 * Why: augur (Auspice export) cannot be solved against FluTyper_env.yaml's python=3.9.15, so the processes that call it
 * carry their own `conda "${moduleDir}/../../../envs/nextstrain.yaml"` directive (moduleDir, not projectDir: in module
 * nf-tests projectDir is the repo root). conda.enabled only affects processes WITH a `conda` directive: every other
 * process gets a .command.run with no conda activation at all and keeps running in the environment Nextflow was
 * launched from (the activated FluTyper env). Verified on Nextflow 26.04.6, also with no conda/mamba binary on PATH.
 *
 * Solver: mamba if on PATH (local miniconda installs), else micromamba (CI: mamba-org/setup-micromamba), else conda.
 * Nextflow refuses both flags at once, hence the "no mamba" guard on useMicromamba (a v2 config cannot reference
 * useMamba from inside the same scope). Options per the Nextflow 26.04 `conda` scope: enabled, cacheDir,
 * createOptions, createTimeout, useMamba, useMicromamba (https://www.nextflow.io/docs/latest/reference/config.html#conda).
 *
 * cacheDir: environments are keyed on the YAML content (env-<hash>), so a fixed per-user folder builds the env once
 * for every run and every nf-test (the default, <workDir>/conda, would rebuild it inside each .nf-test/tests/<hash>/).
 * Override with NXF_CONDA_CACHEDIR (e.g. a shared filesystem on a cluster); CI caches this same folder.
 */
conda {
    enabled = true
    useMamba = System.getenv('PATH')?.tokenize(File.pathSeparator)?.any { dir -> new File(dir, 'mamba').with { it.isFile() && it.canExecute() } } ?: false
    useMicromamba = !(System.getenv('PATH')?.tokenize(File.pathSeparator)?.any { dir -> new File(dir, 'mamba').with { it.isFile() && it.canExecute() } } ?: false) &&
        (System.getenv('PATH')?.tokenize(File.pathSeparator)?.any { dir -> new File(dir, 'micromamba').with { it.isFile() && it.canExecute() } } ?: false)
    cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${System.getProperty('user.home')}/.flutyper/conda"
    createTimeout = '30 min' // cold build (empty package cache) on a CI runner; the default is 20 min
}
