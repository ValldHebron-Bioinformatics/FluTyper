nextflow_process {

    // Test file for the MutationsGraphicReport process

    name "Test Process MutationsGraphicReport"
    script "nf_pipeline/modules/MutationsGraphicReport.nf"
    process "MutationsGraphicReport"

    // Test: Verify that the process successfully creates the HTML report
    // when given a valid Excel file with mutation data
    test("Should create the HTML report") {
        // When: Provide a valid Excel file with mutation data as input
        when {
            params  {
                colorblind = false
                threshold = 0.25
                protocol = "AVIAN"
                protocols = [
                    AVIAN: [ resources: "${projectDir}/tests/data/Graphs_test/" ]
                ]
            }
            process {
                """
                input[0] = file("${projectDir}/tests/data/Graphs_test/relevant_mutations.xlsx")
                input[1] = file("${projectDir}/tests/data/Graphs_test/metadata.csv")
                """
            }
        }

        // Then: Verify the process succeeds and emits exactly one HTML report file
        then {
            // Check that the process executed successfully
            assert process.success

            // Use positional output to avoid named-channel lookup issues in nf-test 0.9.5
            // Get the emitted HTML report file(s) from the output channel
            def reportFiles = process.out[0]
            assert reportFiles != null : "Output channel is null. The HTML report was not emitted."
            assert reportFiles.size() == 1 : "Expected exactly one HTML report file to be emitted"

            // Convert the file path to a Path object for easier checking
            def htmlFile = path(reportFiles[0])
            // Verify that the HTML report file actually exists on disk
            assert htmlFile.exists() : "HTML report file was not created at expected location"
        }
    }

    // Test: multi-season metadata (tests/data/Graphs_seasons) produces the SEASON FROM / SEASON TO
    // range selectors, keeps the latest season as the initial single-season view, and embeds
    // per-season traces (the data the range aggregation is recomputed from).
    test("Should build season range selectors from multi-season metadata") {
        when {
            params  {
                colorblind = false
                threshold = 0.25
                protocol = "AVIAN"
                protocols = [
                    AVIAN: [ resources: "${projectDir}/tests/data/Graphs_test/" ]
                ]
            }
            process {
                """
                input[0] = file("${projectDir}/tests/data/Graphs_test/relevant_mutations.xlsx")
                input[1] = file("${projectDir}/tests/data/Graphs_seasons/metadata.csv")
                """
            }
        }

        then {
            assert process.success
            def reportFiles = process.out[0]
            assert reportFiles != null && reportFiles.size() == 1 : "Expected exactly one HTML report file to be emitted"
            def html = path(reportFiles[0]).text

            // Helper: option values (in order) and the selected value of a <select id=...>
            def selectBlock = { String id ->
                def m = (html =~ /(?s)<select id="${id}"([^>]*)>(.*?)<\/select>/)
                assert m.find() : "Select '${id}' not found in report"
                [attrs: m.group(1), body: m.group(2)]
            }
            def optionValues = { String body -> (body =~ /<option value="([^"]*)"/).collect { it[1] } }
            def selectedValue = { String body ->
                def m = (body =~ /<option value="([^"]*)" selected>/)
                m.find() ? m.group(1) : null
            }

            // SEASON FROM: All Time first, then seasons chronologically, then Unknown Season (2 undated samples)
            def fromSel = selectBlock("seasonSel")
            assert optionValues(fromSel.body) == ["All Time", "2022-2023", "2023-2024", "2024-2025", "Unknown Season"]
            assert selectedValue(fromSel.body) == "2024-2025" : "Initial view must stay on the latest season"
            assert fromSel.attrs.contains('onSeasonFromChange()')

            // SEASON TO: only dated seasons, chronological, starts on the same season and is enabled
            def toSel = selectBlock("seasonToSel")
            assert optionValues(toSel.body) == ["2022-2023", "2023-2024", "2024-2025"]
            assert selectedValue(toSel.body) == "2024-2025"
            assert !toSel.attrs.contains('disabled') : "SEASON TO must be enabled when FROM is a season"
            assert html.contains('<label>SEASON FROM</label>') && html.contains('<label>SEASON TO</label>')

            // Initial title unchanged, range title wording available
            assert html.contains('Mutation Summary per Protein - Season 2024-2025</h2>')
            assert html.contains("'Seasons ' + seasonRange[0] + ' to ' + seasonRange[seasonRange.length - 1]")

            // Per-season and All Time traces are embedded for every season (source of the range sums)
            ["All Time", "2022-2023", "2023-2024", "2024-2025", "Unknown Season"].each { s ->
                assert html.contains('\\"season\\": \\"' + s + '\\"') : "No traces embedded for season ${s}"
            }

            // Filters and navigation hooks still present
            assert html.contains('id="ageSel"') && html.contains('id="sexSel"') && html.contains('id="freqSlider"')
            assert html.contains("type: 'openEvolution'")
        }
    }
}
