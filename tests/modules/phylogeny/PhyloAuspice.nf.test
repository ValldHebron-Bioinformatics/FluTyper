            walk = { n -> byName[n.name] = n; (n.children ?: []).each { c -> parentOf[c.name] = n.name; walk(c) } }
            walk(js.tree)
            def tips = byName.values().findAll { !it.children }.collect { it.name }
            // time tree without 198353883 (no DATE); 01818936 (DATE 2024 = 2024-XX-XX) is kept, placed within 2024
            assert status[1] == "ok" && status[2] == "timetree" : status
            assert status[4].contains("1 undated sample(s) left out of the time tree") : status
            assert tips.size() == 7 && !tips.contains("198353883") && tips.contains("01818936") : tips
            def d = byName["01818936"].node_attrs.num_date
            assert d.raw_value == "2024-XX-XX" && d.confidence[0] >= 2024.0 && d.confidence[1] <= 2025.0 : d
            assert log.contains("PhyloAuspice: WARNING 1 undated sample(s) left out of the time tree (no usable DATE; partial dates such as YYYY-XX-XX are kept): 198353883") : log
            assert log.contains("auspice_dropped_undated.tsv") : log
            def dropped = path(process.out.dropped.get(0)[1]).readLines()
            assert dropped == ["tip\treason", "198353883\tno DATE"] : dropped
            // NODE_0000010 only joined 01816372 and 198353883: it is gone, 01816372 hangs from the surviving ancestor
            assert !byName.containsKey("NODE_0000010")
            assert log.contains("pruning removed 1 internal node(s) left with a single child (NODE_0000010)") : log
            // branch mutations on the pruned tree = parent -> child differences of FluTyper's own sequences
            def fasta = { p ->
                def seqs = [:]; def name = null
                path(p).readLines().each { l -> if (l.startsWith(">")) { name = l.substring(1).trim(); seqs[name] = "" } else seqs[name] += l.trim().toUpperCase() }
                seqs
            }
            def seq = fasta("${projectDir}/tests/data/phylo/auspice/ha_ancestral_nt.fasta") + fasta("${projectDir}/tests/data/phylo/auspice/ha_alignment.fasta")
            def parent = parentOf["01816372"]
            def expected = []
            def a = seq[parent], b = seq["01816372"]
            (0..<a.length()).each { i -> if (a[i] != b[i] && "ACGT".contains(a[i]) && "ACGT".contains(b[i])) expected << "${a[i]}${i + 1}${b[i]}".toString() }
            assert expected.size() > 0
            assert byName["01816372"].branch_attrs.mutations.nuc == expected : "${parent} -> 01816372"
            // no tip has a collection date augur invented
            byName.values().findAll { !it.children }.each { n ->
                def nd = n.node_attrs.num_date
                assert nd && (!nd.inferred || (nd.raw_value ?: "").contains("XX")) : "${n.name}: ${nd}"
            }

        }
    }

    test("D23: a root strain without a date is never dropped: the tree is exported divergence-only with all tips and a WARNING") {

        when {
            process {
                """
                input[0] = tuple(
                    "H3N2_HA",
                    "HA",
                    file("${projectDir}/tests/data/phylo/phylo_tree.nwk", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_alignment.fasta", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_ancestral_nt.fasta", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_ancestral_aa", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_segments.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_gene_map.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/annotations.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/node_support.tsv", checkIfExists: true)
                )
                input[1] = file("${projectDir}/tests/data/phylo/auspice/geo.tsv", checkIfExists: true)
                input[2] = file("${projectDir}/tests/data/phylo/auspice/lat_longs.tsv", checkIfExists: true)
                input[3] = file("${projectDir}/tests/data/phylo/auspice/metadata_undated.csv", checkIfExists: true)
                input[4] = file("${projectDir}/RESOURCES/auspice_config.json", checkIfExists: true)
                input[5] = file("${projectDir}/RESOURCES/auspice_clock_rates.tsv", checkIfExists: true)
                input[6] = file("${projectDir}/tests/data/phylo/auspice/root_strains_noyear.tsv", checkIfExists: true)
                input[7] = []
                input[8] = 1
                input[9] = "country,region"
                input[10] = "1.1.0"
                input[11] = 70
                input[12] = file("${projectDir}/tests/data/phylo/auspice/nextstrain_env.txt", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            def log = path(process.out.step_log.get(0)[1]).text
            def status = path(process.out.status.get(0)[2]).readLines()[1].split("\t", -1)
            def js = new JsonSlurper().parse(file(process.out.json.get(0)[1]))
            def byName = [:]
            def parentOf = [:]
            def walk
            walk = { n -> byName[n.name] = n; (n.children ?: []).each { c -> parentOf[c.name] = n.name; walk(c) } }
            walk(js.tree)
            def tips = byName.values().findAll { !it.children }.collect { it.name }
            assert status[1] == "ok" && status[2] == "divergence" : status
            assert status[4].contains("root strain(s) without a date (REF_A_Massachusetts_18_2022)") : status
            assert log =~ /PhyloAuspice: WARNING root strain\(s\) without a date \(REF_A_Massachusetts_18_2022\).*divergence-only tree with all tips/ : log
            assert tips.size() == 8 && tips.contains("198353883") : tips
            assert process.out.dropped.size() == 0

        }
    }

    test("D23: pruning is not attempted when fewer dated samples than --auspiceMinDatedTips remain: divergence-only with all tips") {

        when {
            process {
                """
                input[0] = tuple(
                    "H3N2_HA",
                    "HA",
                    file("${projectDir}/tests/data/phylo/phylo_tree.nwk", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_alignment.fasta", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_ancestral_nt.fasta", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_ancestral_aa", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_segments.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_gene_map.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/annotations.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/node_support.tsv", checkIfExists: true)
                )
                input[1] = file("${projectDir}/tests/data/phylo/auspice/geo.tsv", checkIfExists: true)
                input[2] = file("${projectDir}/tests/data/phylo/auspice/lat_longs.tsv", checkIfExists: true)
                input[3] = file("${projectDir}/tests/data/phylo/auspice/metadata_undated.csv", checkIfExists: true)
                input[4] = file("${projectDir}/RESOURCES/auspice_config.json", checkIfExists: true)
                input[5] = file("${projectDir}/RESOURCES/auspice_clock_rates.tsv", checkIfExists: true)
                input[6] = file("${projectDir}/tests/data/phylo/root_strains.tsv", checkIfExists: true)
                input[7] = []
                input[8] = 3
                input[9] = "country,region"
                input[10] = "1.1.0"
                input[11] = 70
                input[12] = file("${projectDir}/tests/data/phylo/auspice/nextstrain_env.txt", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            def log = path(process.out.step_log.get(0)[1]).text
            def status = path(process.out.status.get(0)[2]).readLines()[1].split("\t", -1)
            def js = new JsonSlurper().parse(file(process.out.json.get(0)[1]))
            def byName = [:]
            def parentOf = [:]
            def walk
            walk = { n -> byName[n.name] = n; (n.children ?: []).each { c -> parentOf[c.name] = n.name; walk(c) } }
            walk(js.tree)
            def tips = byName.values().findAll { !it.children }.collect { it.name }
            assert status[2] == "divergence" && status[4].contains("only 1 tip(s) dated to at least the month (minimum 3)") : status
            assert tips.size() == 8 && tips.contains("198353883") : tips
            assert process.out.dropped.size() == 0
            assert !log.contains("left out of the time tree") : log
            // P7-3: every sample is in Barcelona -> country (Spain) and region (Europe) have one state each: no augur traits at all
            assert log.contains("PhyloAuspice: INFO no ancestral-state reconstruction: no trait column has 2 or more known states.") : log
            assert !byName["NODE_0000009"].node_attrs.containsKey("country") : byName["NODE_0000009"].node_attrs

        }
    }
}
