            walk(js.tree)
            ["01816372": "2024/03", "01818936": "Mar 2024", "198353883": "2024-11-05T10:00"].each { tip, raw ->
                assert log.contains("PhyloAuspice: WARNING DATE '${raw}' of ${tip} is not an ISO date") : log
            }
            assert log.contains("0 dated to the day, 0 to the month, 5 to the year only, 3 undated.") : log
            // --auspiceTraits none (the subworkflow passes ""): no augur traits, so no inferred country on internal nodes
            assert log.contains("PhyloAuspice: INFO no ancestral-state reconstruction (--auspiceTraits none).") : log
            assert !byName["NODE_0000009"].node_attrs.containsKey("country") : byName["NODE_0000009"].node_attrs
            assert byName["01816372"].node_attrs.country?.value == "Spain"     // tips keep their metadata

        }
    }

