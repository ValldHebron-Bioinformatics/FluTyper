    test("D6: the coarsening check fails loudly when a collapsed branch carries a reconstructed change (synthetic): no JSON, status failed") {

        when {
            process {
                """
                input[0] = tuple(
                    "H3N2",
                    "whole_genome",
                    file("${projectDir}/tests/data/phylo/auspice/tree_zero_branch.nwk", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/ancestral_nt.fasta", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/ancestral_aa", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/phylo_segments.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/gene_map.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/annotations.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/node_support.tsv", checkIfExists: true)
                )
                input[1] = file("${projectDir}/tests/data/phylo/auspice/geo.tsv", checkIfExists: true)
                input[2] = file("${projectDir}/tests/data/phylo/auspice/lat_longs.tsv", checkIfExists: true)
                input[3] = file("${projectDir}/tests/data/phylo/auspice/metadata_auspice.csv", checkIfExists: true)
                input[4] = file("${projectDir}/RESOURCES/auspice_config.json", checkIfExists: true)
                input[5] = file("${projectDir}/RESOURCES/auspice_clock_rates.tsv", checkIfExists: true)
                input[6] = file("${projectDir}/tests/data/phylo/root_strains.tsv", checkIfExists: true)
                input[7] = []
                input[8] = 3
                input[9] = "country,region"
                input[10] = "1.1.0"
                input[11] = 70
                input[12] = file("${projectDir}/tests/data/phylo/auspice/nextstrain_env.txt", checkIfExists: true)   // AuspiceEnvCheck report (gate)
                """
            }
        }

        then {
            // The task itself succeeds so that its log and status reach PhyloLog / tree_problems (errorStrategy
            // 'ignore' would otherwise discard them); the failure is in the status and the log, and no JSON is emitted
            assert process.success
            assert process.out.json.size() == 0
            def log = path(process.out.step_log.get(0)[1]).text
            assert log =~ /PhyloAuspice: ERROR D6 coarsening check failed: .*NODE_0000010.*1 reconstructed nucleotide change/ : log
            def status = path(process.out.status.get(0)[2]).readLines()
            assert status[1].startsWith("H3N2\tfailed\t") : status
            assert status[1].contains("coarsening") : status
        }
    }

    test("H1 + COUNTRY join: partial ISO dates keep their precision, a non-ISO date is undated with a WARNING; COUNTRY 'NA' = Namibia; a (LOCATION, COUNTRY) missing from geo.tsv keeps its location only") {

        when {
            process {
                """
                input[0] = tuple(
                    "H3N2_HA",
                    "HA",
                    file("${projectDir}/tests/data/phylo/phylo_tree.nwk", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_alignment.fasta", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_ancestral_nt.fasta", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_ancestral_aa", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_segments.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/ha_gene_map.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/auspice/annotations.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/node_support.tsv", checkIfExists: true)
                )
                input[1] = file("${projectDir}/tests/data/phylo/auspice/geo_country.tsv", checkIfExists: true)
                input[2] = file("${projectDir}/tests/data/phylo/auspice/lat_longs.tsv", checkIfExists: true)
                input[3] = file("${projectDir}/tests/data/phylo/auspice/metadata_dates_country.csv", checkIfExists: true)
                input[4] = file("${projectDir}/RESOURCES/auspice_config.json", checkIfExists: true)
                input[5] = file("${projectDir}/RESOURCES/auspice_clock_rates.tsv", checkIfExists: true)
                input[6] = file("${projectDir}/tests/data/phylo/root_strains.tsv", checkIfExists: true)
                input[7] = []
                input[8] = 3
                input[9] = "country,region"
                input[10] = "1.1.0"
                input[11] = 70
                input[12] = file("${projectDir}/tests/data/phylo/auspice/nextstrain_env.txt", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            def log = path(process.out.step_log.get(0)[1]).text
            def status = path(process.out.status.get(0)[2]).readLines()[1].split("\t", -1)
            def js = new JsonSlurper().parse(file(process.out.json.get(0)[1]))
            def byName = [:]
            def walk
            walk = { n -> byName[n.name] = n; (n.children ?: []).each { walk(it) } }
            walk(js.tree)
            // 2024-11 -> month precision, 2024 -> year only; 03/04/2024 is ambiguous (day/month) -> undated, never guessed
            assert log.contains("PhyloAuspice: WARNING DATE '03/04/2024' of 01818936 is not an ISO date (YYYY, YYYY-MM, YYYY-MM-DD or the XX forms): left undated.") : log
            assert log.contains("PhyloAuspice: INFO 8 tips: 0 dated to the day, 1 to the month, 6 to the year only, 1 undated.") : log
            // too few tips dated to the month -> divergence-only; M5: the reason is in the status
            assert status[1] == "ok" && status[2] == "divergence" && status[4].contains("only 1 tip(s) dated to at least the month") : status
            // COUNTRY join: (Windhoek, NA) -> Namibia; (Barcelona, blank) -> Spain
            assert byName["01816372"].node_attrs.country?.value == "Namibia" : byName["01816372"].node_attrs
            assert byName["01818936"].node_attrs.country?.value == "Spain"
            // not in geo.tsv: WARNING, the metadata location is kept, no country/division/region is made up
            assert log.contains("PhyloAuspice: WARNING 198353883: (LOCATION 'Gotham', COUNTRY '') is not in geo.tsv") : log
            assert byName["198353883"].node_attrs.location?.value == "Gotham"
            assert !byName["198353883"].node_attrs.containsKey("country")

        }
    }

