                input[7] = file("${projectDir}/tests/data/phylo/phylo_coverage_qc.tsv", checkIfExists: true)
                input[8] = file("${projectDir}/tests/data/phylo/reference_segments.tsv", checkIfExists: true)
                input[9] = file("${projectDir}/tests/data/phylo/root_strains.tsv", checkIfExists: true)
                input[10] = [file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true)]
                input[11] = "week"
                input[12] = 0.8
                input[13] = 6
                input[14] = 5
                input[15] = 72
                input[16] = 70
                input[17] = groovy.json.JsonOutput.toJson([
                    pipeline_version: "1.1.0", started: "2024-01-01T00:00:00Z",
                    parameters: [phyloMinCoverage: "0.95", model: "GTR+G4", bootstrap: "1000", seed: "12345",
                                 phyloOutgroup: "A/Darwin/6/2021", clusterThreshold: "0.005"]
                ]).bytes.encodeBase64().toString()
                """
            }
        }

        then {
            assert process.success
            def annotations = path(process.out.annotations.get(0)[1]).text.readLines()
            def byId = annotations.drop(1).collectEntries { line -> def f = line.split("\t", -1); [(f[0]): f] }
            // 01818936's DATE in metadata_lab_partial.csv is '2024-08' (year-month only): no day to place it in a week
            assert byId["01818936"][5] == "NA" : "expected NA, got ${byId['01818936'][5]}"
        }
    }

    test("Should write a run manifest with tools, parameters, checksummed inputs, panel status and QC counts, and list tip and internal aa_states rows") {

        when {
            process {
                """
                                input[0] = tuple(
                    "H3N2",
                    "whole_genome",
                    file("${projectDir}/tests/data/phylo/phylo_tree.nwk", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/node_support.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/clusters.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/ancestral_aa", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/phylo_segments.tsv", checkIfExists: true)
                )
                input[1] = file("${projectDir}/tests/data/phylo/subclades.tsv", checkIfExists: true)
                input[2] = file("${projectDir}/tests/data/phylo/aa_positions.tsv", checkIfExists: true)
                input[3] = file("${projectDir}/tests/data/phylo/metadata_lab.csv", checkIfExists: true)
                input[4] = []
                input[5] = file("${projectDir}/RESOURCES/phylo_panels.tsv", checkIfExists: true)
                input[6] = file("${projectDir}/tests/data/phylo/phylo_tool_versions.json", checkIfExists: true)
                input[7] = file("${projectDir}/tests/data/phylo/phylo_coverage_qc.tsv", checkIfExists: true)
                input[8] = file("${projectDir}/tests/data/phylo/reference_segments.tsv", checkIfExists: true)
                input[9] = file("${projectDir}/tests/data/phylo/root_strains.tsv", checkIfExists: true)
                input[10] = [
                    file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/metadata_lab.csv", checkIfExists: true)
                ]
                input[11] = "month"
                input[12] = 0.8
                input[13] = 6
                input[14] = 5
                input[15] = 72
                input[16] = 70
                input[17] = groovy.json.JsonOutput.toJson([
                    pipeline_version: "1.1.0", started: "2024-01-01T00:00:00Z",
                    parameters: [phyloMinCoverage: "0.95", model: "GTR+G4", bootstrap: "1000", seed: "12345",
                                 phyloOutgroup: "A/Darwin/6/2021", clusterThreshold: "0.005"]
                ]).bytes.encodeBase64().toString()
                """
            }
        }

        then {
            assert process.success

            def manifest = new JsonSlurper().parse(path(process.out.manifest.get(0)[1]).toFile())
            assert manifest.pipeline_version == "1.1.0"
            assert manifest.tools.mafft.status == "ok"
            assert manifest.parameters.model == "GTR+G4"

            assert manifest.inputs.size() == 2
            def alignmentInput = manifest.inputs.find { it.file == "phylo_alignment.fasta" }
            assert alignmentInput != null
            assert alignmentInput.sha256 ==~ /^[0-9a-f]{64}$/

            // 6 QC candidates (01816372, 01816747, 01817974, 01818936, 01821259, 198353883), 3 passed (all segments PASS)
            assert manifest.qc.candidates == 6
            assert manifest.qc.passed == 3
            assert manifest.qc.dropped.size() == 3

            assert manifest.panels.rendered.contains("subclade")
            assert manifest.panels.skipped.size() >= 0
            assert (manifest.panels.rendered + manifest.panels.skipped.collect { it.panel }).contains("source")

            def aaStatesLines = path(process.out.aa_states.get(0)[1]).text.readLines()
            assert aaStatesLines[0] == "node\tnode_type\tlabel\tgene\tposition\taa"
            def rows = aaStatesLines.drop(1)
            assert rows.any { it.startsWith("01816372\ttip\t") } : "aa_states.tsv should list a tip row for 01816372"
            assert rows.any { it =~ /^NODE_\d+\tinternal\t/ } : "aa_states.tsv should list internal node rows"

            def htmlFile = path(process.out.html.get(0)[1])
            assert htmlFile.exists() && htmlFile.size() > 0
        }
    }

    test("Should build the interactive HTML tree with season/age/sex filters and per-tip hover data") {

        when {
            process {
                """
                                input[0] = tuple(
                    "H3N2",
                    "whole_genome",
                    file("${projectDir}/tests/data/phylo/phylo_tree.nwk", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/node_support.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/clusters.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/ancestral_aa", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/phylo_segments.tsv", checkIfExists: true)
                )
                input[1] = file("${projectDir}/tests/data/phylo/subclades.tsv", checkIfExists: true)
                input[2] = file("${projectDir}/tests/data/phylo/aa_positions.tsv", checkIfExists: true)
                input[3] = file("${projectDir}/tests/data/phylo/metadata_lab.csv", checkIfExists: true)
                input[4] = []
                input[5] = file("${projectDir}/RESOURCES/phylo_panels.tsv", checkIfExists: true)
                input[6] = file("${projectDir}/tests/data/phylo/phylo_tool_versions.json", checkIfExists: true)
                input[7] = file("${projectDir}/tests/data/phylo/phylo_coverage_qc.tsv", checkIfExists: true)
                input[8] = file("${projectDir}/tests/data/phylo/reference_segments.tsv", checkIfExists: true)
                input[9] = file("${projectDir}/tests/data/phylo/root_strains.tsv", checkIfExists: true)
                input[10] = [file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true)]
                input[11] = "month"
                input[12] = 0.8
                input[13] = 6
                input[14] = 5
                input[15] = 72
                input[16] = 70
                input[17] = groovy.json.JsonOutput.toJson([
                    pipeline_version: "1.1.0", started: "2024-01-01T00:00:00Z",
                    parameters: [phyloMinCoverage: "0.95", model: "GTR+G4", bootstrap: "1000", seed: "12345",
                                 phyloOutgroup: "A/Darwin/6/2021", clusterThreshold: "0.005"]
                ]).bytes.encodeBase64().toString()
                """
            }
        }

        then {
            assert process.success
            def htmlText = path(process.out.html.get(0)[1]).text
            assert htmlText.contains("<title>Phylogenetic Tree - H3N2 - whole-genome phylogeny</title>")
            assert htmlText.contains("const D = {")

            def m = htmlText =~ /const D = (\{.+?\});\n/
            assert m.find() : "could not find the embedded 'const D = {...};' JSON payload"
            def payload = new JsonSlurper().parseText(m.group(1))

            // metadata_lab.csv DATEs: 01816372=2024-11-05 (season 2024-2025), 01818936=2024-08-20 (season 2023-2024),
            // 198353883=2024-11-18 (season 2024-2025); AGE GROUP 15-65/65+/0-4; SEX F/M/F
            assert payload.seasons == ["2023-2024", "2024-2025"] : "unexpected seasons: ${payload.seasons}"
            assert payload.ages == ["0-4", "15-65", "65+"] : "unexpected ages: ${payload.ages}"
            assert payload.sexes == ["F", "M"] : "unexpected sexes: ${payload.sexes}"

            assert payload.filter["01816372"].season == "2024-2025"
            assert payload.filter["01818936"].season == "2023-2024"
            assert payload.filter["198353883"].season == "2024-2025"
            assert payload.filter["01816372"].sample == true
            // Reference (root) strains are always kept, regardless of the filters
            assert payload.filter["REF_A_Darwin_6_2021"].sample == false

            assert payload.hover["01816372"].contains("01816372")
            assert payload.panels.any { it.name == "subclade" }

            // --minSupportLabel 70 (input[16]): node_support.tsv keeps every value unfiltered in the payload (only
            // the drawn labels are filtered, client-side); NODE_0000007 (62) is below the threshold, NODE_0000003
            // (100) is at/above it, and the threshold itself is embedded so the browser can filter consistently
            assert payload.minSupportLabel == 70
            def nodeIdx = { String name -> payload.name.findIndexOf { it == name } }
            assert payload.support[nodeIdx("NODE_0000007")] == "62"
            assert payload.support[nodeIdx("NODE_0000003")] == "100"
            def htmlSource = path(process.out.html.get(0)[1]).text
            assert htmlSource.contains("Number(D.support[d.j]) >= D.minSupportLabel") :
                "the interactive tree's drawn-label filter must compare against D.minSupportLabel"

            assert payload.name.size() == payload.parent.size()
            assert payload.tip.size() == payload.parent.size()
        }
    }

    test("Should embed --minSupportLabel 0 so every node's support label is shown") {

        when {
            process {
                """
                input[0] = tuple(
                    "H3N2",
                    "whole_genome",
                    file("${projectDir}/tests/data/phylo/phylo_tree.nwk", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/node_support.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/clusters.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/ancestral_aa", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/phylo_segments.tsv", checkIfExists: true)
                )
                input[1] = file("${projectDir}/tests/data/phylo/subclades.tsv", checkIfExists: true)
                input[2] = file("${projectDir}/tests/data/phylo/aa_positions.tsv", checkIfExists: true)
                input[3] = file("${projectDir}/tests/data/phylo/metadata_lab.csv", checkIfExists: true)
                input[4] = []
                input[5] = file("${projectDir}/RESOURCES/phylo_panels.tsv", checkIfExists: true)
                input[6] = file("${projectDir}/tests/data/phylo/phylo_tool_versions.json", checkIfExists: true)
                input[7] = file("${projectDir}/tests/data/phylo/phylo_coverage_qc.tsv", checkIfExists: true)
                input[8] = file("${projectDir}/tests/data/phylo/reference_segments.tsv", checkIfExists: true)
                input[9] = file("${projectDir}/tests/data/phylo/root_strains.tsv", checkIfExists: true)
                input[10] = [file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true)]
                input[11] = "month"
                input[12] = 0.8
                input[13] = 6
                input[14] = 5
                input[15] = 72
                input[16] = 0
                input[17] = groovy.json.JsonOutput.toJson([
                    pipeline_version: "1.1.0", started: "2024-01-01T00:00:00Z",
                    parameters: [phyloMinCoverage: "0.95", model: "GTR+G4", bootstrap: "1000", seed: "12345",
                                 phyloOutgroup: "A/Darwin/6/2021", clusterThreshold: "0.005"]
                ]).bytes.encodeBase64().toString()
                """
            }
        }

        then {
            assert process.success
            def htmlText = path(process.out.html.get(0)[1]).text
            def m = htmlText =~ /const D = (\{.+?\});\n/
            assert m.find() : "could not find the embedded 'const D = {...};' JSON payload"
            def payload = new JsonSlurper().parseText(m.group(1))
            assert payload.minSupportLabel == 0
            // Every non-empty support value (47, 62, 100...) is now >= the threshold, so every one would be drawn
            assert payload.support.findAll { it != "" }.every { it.toInteger() >= 0 }
        }
    }

    test("Should drop aa-position columns whose gene has no ancestral_aa file for this tree (segment-tree filtering)") {

        when {
            process {
                """
                input[0] = tuple(
