                    file("${projectDir}/tests/data/phylo/phylo_segments.tsv", checkIfExists: true)
                )
                input[1] = file("${projectDir}/tests/data/phylo/subclades.tsv", checkIfExists: true)
                input[2] = file("${projectDir}/tests/data/phylo/aa_positions_ha_na.tsv", checkIfExists: true)
                input[3] = file("${projectDir}/tests/data/phylo/metadata_lab.csv", checkIfExists: true)
                input[4] = []
                input[5] = file("${projectDir}/RESOURCES/phylo_panels.tsv", checkIfExists: true)
                input[6] = file("${projectDir}/tests/data/phylo/phylo_tool_versions.json", checkIfExists: true)
                input[7] = file("${projectDir}/tests/data/phylo/phylo_coverage_qc.tsv", checkIfExists: true)
                input[8] = file("${projectDir}/tests/data/phylo/reference_segments.tsv", checkIfExists: true)
                input[9] = file("${projectDir}/tests/data/phylo/root_strains.tsv", checkIfExists: true)
                input[10] = [file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true)]
                input[11] = "month"
                input[12] = 0.8
                input[13] = 6
                input[14] = 5
                input[15] = 72
                input[16] = 70
                input[17] = groovy.json.JsonOutput.toJson([
                    pipeline_version: "1.1.0", started: "2024-01-01T00:00:00Z",
                    parameters: [phyloMinCoverage: "0.95", model: "GTR+G4", bootstrap: "1000", seed: "12345",
                                 phyloOutgroup: "A/Darwin/6/2021", clusterThreshold: "0.005"]
                ]).bytes.encodeBase64().toString()
                """
            }
        }

        then {
            assert process.success
            // aa_positions_ha_na.tsv requests HA1:62 and NA:10, but this NA tree's ancestral_aa/ only has NA.fasta:
            // HA1:62 has no gene file for this tree and must be dropped; NA:10 must stay
            def header = path(process.out.annotations.get(0)[1]).text.readLines()[0].split("\t", -1)
            assert !header.contains("HA1:62") : "HA1:62 should be dropped: ${header}"
            assert header.contains("NA:10") : "NA:10 should be kept: ${header}"

            def sourcesText = path(process.out.sources.get(0)[1]).text
            assert !sourcesText.contains("HA1:62\t")
            assert sourcesText.contains("NA:10\t")
        }
    }

    test("Should label a node with support exactly at --minSupportLabel (70) but not one at 69.9, in both the SVG and the interactive payload") {

        when {
            process {
                """
                input[0] = tuple(
                    "H3N2",
                    "whole_genome",
                    file("${projectDir}/tests/data/phylo/phylo_tree.nwk", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/node_support_boundary.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/clusters.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/ancestral_aa", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/phylo_segments.tsv", checkIfExists: true)
                )
                input[1] = file("${projectDir}/tests/data/phylo/subclades.tsv", checkIfExists: true)
                input[2] = file("${projectDir}/tests/data/phylo/aa_positions.tsv", checkIfExists: true)
                input[3] = file("${projectDir}/tests/data/phylo/metadata_lab.csv", checkIfExists: true)
                input[4] = []
                input[5] = file("${projectDir}/RESOURCES/phylo_panels.tsv", checkIfExists: true)
                input[6] = file("${projectDir}/tests/data/phylo/phylo_tool_versions.json", checkIfExists: true)
                input[7] = file("${projectDir}/tests/data/phylo/phylo_coverage_qc.tsv", checkIfExists: true)
                input[8] = file("${projectDir}/tests/data/phylo/reference_segments.tsv", checkIfExists: true)
                input[9] = file("${projectDir}/tests/data/phylo/root_strains.tsv", checkIfExists: true)
                input[10] = [file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true)]
                input[11] = "month"
                input[12] = 0.8
                input[13] = 6
                input[14] = 5
                input[15] = 72
                input[16] = 70
                input[17] = groovy.json.JsonOutput.toJson([
                    pipeline_version: "1.1.0", started: "2024-01-01T00:00:00Z",
                    parameters: [phyloMinCoverage: "0.95", model: "GTR+G4", bootstrap: "1000", seed: "12345",
                                 phyloOutgroup: "A/Darwin/6/2021", clusterThreshold: "0.005"]
                ]).bytes.encodeBase64().toString()
                """
            }
        }

        then {
            assert process.success

            // Interactive payload: minSupportLabel is embedded and every raw support value is kept unfiltered,
            // so a client can compute "Number(support) >= minSupportLabel" itself (70 >= 70 true, 69.9 >= 70 false)
            def htmlText = path(process.out.html.get(0)[1]).text
            def m = htmlText =~ /const D = (\{.+?\});\n/
            assert m.find()
            def payload = new JsonSlurper().parseText(m.group(1))
            assert payload.minSupportLabel == 70
            def nodeIdx = { String name -> payload.name.findIndexOf { it == name } }
            assert payload.support[nodeIdx("NODE_0000003")] == "70"
            assert payload.support[nodeIdx("NODE_0000005")] == "69.9"

            // Static SVG: ggtree/ggplot2 render each drawn label as its own <text ...>VALUE</text> element
            def svgText = path(process.out.svg.get(0)[1]).text
            assert svgText.contains(">70<") : "the node at exactly the threshold (70) should be labelled in the SVG"
            assert !svgText.contains(">69.9<") : "the node below the threshold (69.9) should not be labelled in the SVG"
        }
    }

}
