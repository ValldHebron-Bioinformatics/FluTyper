import groovy.json.JsonSlurper

nextflow_process {

    name "Test Process PhyloReport"
    script "nf_pipeline/modules/phylogeny/PhyloReport.nf"
    process "PhyloReport"

    test("Should render the source panel when the metadata has an ORIGINATING_LAB column") {

        when {
            process {
                """
                                input[0] = tuple(
                    "H3N2",
                    "whole_genome",
                    file("${projectDir}/tests/data/phylo/phylo_tree.nwk", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/node_support.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/clusters.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/ancestral_aa", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/phylo_segments.tsv", checkIfExists: true)
                )
                input[1] = file("${projectDir}/tests/data/phylo/subclades.tsv", checkIfExists: true)
                input[2] = file("${projectDir}/tests/data/phylo/aa_positions.tsv", checkIfExists: true)
                input[3] = file("${projectDir}/tests/data/phylo/metadata_lab.csv", checkIfExists: true)
                input[4] = []
                input[5] = file("${projectDir}/RESOURCES/phylo_panels.tsv", checkIfExists: true)
                input[6] = file("${projectDir}/tests/data/phylo/phylo_tool_versions.json", checkIfExists: true)
                input[7] = file("${projectDir}/tests/data/phylo/phylo_coverage_qc.tsv", checkIfExists: true)
                input[8] = file("${projectDir}/tests/data/phylo/reference_segments.tsv", checkIfExists: true)
                input[9] = file("${projectDir}/tests/data/phylo/root_strains.tsv", checkIfExists: true)
                input[10] = [file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true)]
                input[11] = "month"
                input[12] = 0.8
                input[13] = 6
                input[14] = 5
                input[15] = 72
                input[16] = 70
                input[17] = groovy.json.JsonOutput.toJson([
                    pipeline_version: "1.1.0", started: "2024-01-01T00:00:00Z",
                    parameters: [phyloMinCoverage: "0.95", model: "GTR+G4", bootstrap: "1000", seed: "12345",
                                 phyloOutgroup: "A/Darwin/6/2021", clusterThreshold: "0.005"]
                ]).bytes.encodeBase64().toString()
                """
            }
        }

        then {
            assert process.success
            def sources = path(process.out.sources.get(0)[1]).text
            assert sources.contains("source_group\tORIGINATING_LAB\tyes\traw values")

            def panels = path(process.out.panels.get(0)[1]).text.readLines()
            def sourceRow = panels.find { it.startsWith("source\t") }
            assert sourceRow != null
            assert sourceRow.split("\t")[2] == "rendered" : "source panel should be rendered: ${sourceRow}"

            assert path(process.out.svg.get(0)[1]).exists()
            assert path(process.out.png.get(0)[1]).exists()

            def htmlFile = path(process.out.html.get(0)[1])
            assert htmlFile.exists() && htmlFile.size() > 0
            assert htmlFile.toString().endsWith("PhylogeneticTreeReport_H3N2.html")
        }
    }

