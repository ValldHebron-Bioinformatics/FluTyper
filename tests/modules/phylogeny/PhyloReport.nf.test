            def seasonLine = sourcesLines.find { it.startsWith("season\t") }
            def ageLine = sourcesLines.find { it.startsWith("age_group\t") }
            def sexLine = sourcesLines.find { it.startsWith("sex\t") }
            assert sourceLine.split("\t")[2] == "no"
            assert sourceLine.contains("no --metadata provided")
            assert periodLine.split("\t")[2] == "no"
            assert periodLine.contains("no --metadata provided")
            [seasonLine, ageLine, sexLine].each { line ->
                assert line != null
                assert line.split("\t")[2] == "no"
                assert line.contains("no --metadata provided")
            }
        }
    }

    test("Should group originating labs with --labMap (Hospital/Community/Other, case-insensitive match)") {

        when {
            process {
                """
                                input[0] = tuple(
                    "H3N2",
                    "whole_genome",
                    file("${projectDir}/tests/data/phylo/phylo_tree.nwk", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/node_support.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/clusters.tsv", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/ancestral_aa", checkIfExists: true),
                    file("${projectDir}/tests/data/phylo/phylo_segments.tsv", checkIfExists: true)
                )
                input[1] = file("${projectDir}/tests/data/phylo/subclades.tsv", checkIfExists: true)
                input[2] = file("${projectDir}/tests/data/phylo/aa_positions.tsv", checkIfExists: true)
                input[3] = file("${projectDir}/tests/data/phylo/metadata_lab.csv", checkIfExists: true)
                input[4] = file("${projectDir}/tests/data/phylo/lab_map.tsv", checkIfExists: true)
                input[5] = file("${projectDir}/RESOURCES/phylo_panels.tsv", checkIfExists: true)
                input[6] = file("${projectDir}/tests/data/phylo/phylo_tool_versions.json", checkIfExists: true)
                input[7] = file("${projectDir}/tests/data/phylo/phylo_coverage_qc.tsv", checkIfExists: true)
                input[8] = file("${projectDir}/tests/data/phylo/reference_segments.tsv", checkIfExists: true)
                input[9] = file("${projectDir}/tests/data/phylo/root_strains.tsv", checkIfExists: true)
                input[10] = [file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true)]
                input[11] = "month"
                input[12] = 0.8
                input[13] = 6
                input[14] = 5
                input[15] = 72
                input[16] = 70
                input[17] = groovy.json.JsonOutput.toJson([
                    pipeline_version: "1.1.0", started: "2024-01-01T00:00:00Z",
                    parameters: [phyloMinCoverage: "0.95", model: "GTR+G4", bootstrap: "1000", seed: "12345",
                                 phyloOutgroup: "A/Darwin/6/2021", clusterThreshold: "0.005"]
                ]).bytes.encodeBase64().toString()
                """
            }
        }

        then {
            assert process.success
            def annotations = path(process.out.annotations.get(0)[1]).text.readLines()
            def byId = annotations.drop(1).collectEntries { line -> def f = line.split("\t", -1); [(f[0]): f] }
            // lab_map.tsv: LabA -> Hospital (exact match); labb -> Community (case-insensitive match of LabB); LabC is unmapped -> Other
            assert byId["01816372"][4] == "Hospital" : "01816372 (LabA) should be grouped as Hospital: ${byId['01816372']}"
            assert byId["01818936"][4] == "Community" : "01818936 (LabB) should be grouped as Community via the case-insensitive 'labb' entry: ${byId['01818936']}"
            assert byId["198353883"][4] == "Other" : "198353883 (LabC, unmapped) should be grouped as Other: ${byId['198353883']}"

            def sources = path(process.out.sources.get(0)[1]).text
            assert sources.contains("grouped with --labMap")
            assert process.stdout.join("\\n").contains("--labMap matched")
        }
    }

