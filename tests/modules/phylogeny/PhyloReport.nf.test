            }
        }

        then {
            assert process.success
            def panelsLines = path(process.out.panels.get(0)[1]).text.readLines()
            def sourceRow = panelsLines.find { it.startsWith("source\t") }
            assert sourceRow.split("\t")[2] == "skipped" : "source panel should be skipped at min_panel_coverage 0.7: ${sourceRow}"
            assert sourceRow.split("\t")[3] == "0.6667" : "expected coverage 0.6667, got ${sourceRow}"
            assert sourceRow.contains("below --minPanelCoverage")
        }
    }

