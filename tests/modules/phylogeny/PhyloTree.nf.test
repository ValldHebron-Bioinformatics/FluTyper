nextflow_process {

    name "Test Process PhyloTree"
    script "nf_pipeline/modules/phylogeny/PhyloTree.nf"
    process "PhyloTree"

    // Shared across test() blocks in this file, used by the two determinism tests below
    def firstRunTree = null

    test("Should build a rooted ML tree with all 8 tips and numeric bootstrap support") {

        when {
            process {
                """
                input[0] = tuple("H3N2", "whole_genome", file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true), "REF_A_Darwin_6_2021", file("${projectDir}/tests/data/phylo/phylo_segments.tsv", checkIfExists: true))
                input[1] = "GTR+G4"
                input[2] = 1000
                input[3] = 12345
                """
            }
        }

        then {
            assert process.success

            def treeText = path(process.out.tree.get(0)[1]).text
            [
                "REF_A_Darwin_6_2021", "REF_A_Massachusetts_18_2022", "REF_A_Croatia_10136RV_2023",
                "REF_A_Singapore_GP20238_2024", "REF_A_Sydney_1359_2024",
                "01816372", "01818936", "198353883"
            ].each { tip ->
                assert treeText.contains(tip) : "tip ${tip} missing from phylo_tree.nwk"
            }

            def supportLines = path(process.out.support.get(0)[1]).text.readLines()
            assert supportLines[0] == "node\tsupport"
            def supportValues = supportLines.drop(1).collect { it.split("\t", -1)[1] }
            // The root's support is always empty; every other internal node must carry a numeric value
            def nonRootValues = supportValues.findAll { it != "" }
            assert nonRootValues.size() >= 1 : "expected at least one internal node with a numeric bootstrap value"
            nonRootValues.each { v ->
                assert v.isNumber() : "support value '${v}' is not numeric"
                def n = v.toDouble()
                assert n >= 0 && n <= 100 : "support value ${n} out of the expected 0-100 range"
            }
        }
    }

    test("Should leave every support value empty when bootstrap is 0") {

        when {
            process {
                """
                input[0] = tuple("H3N2", "whole_genome", file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true), "REF_A_Darwin_6_2021", file("${projectDir}/tests/data/phylo/phylo_segments.tsv", checkIfExists: true))
                input[1] = "GTR+G4"
                input[2] = 0
                input[3] = 12345
                """
            }
        }

        then {
            assert process.success
            def supportLines = path(process.out.support.get(0)[1]).text.readLines()
            assert supportLines[0] == "node\tsupport"
            def supportValues = supportLines.drop(1).collect { it.split("\t", -1)[1] }
            assert supportValues.every { it == "" } : "every support value should be empty when bootstrap is 0: ${supportValues}"
        }
    }

    test("Should produce an identical treefile on a first run with a fixed seed (determinism, part 1)") {

        when {
            process {
                """
                input[0] = tuple("H3N2", "whole_genome", file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true), "REF_A_Darwin_6_2021", file("${projectDir}/tests/data/phylo/phylo_segments.tsv", checkIfExists: true))
                input[1] = "GTR+G4"
                input[2] = 0
                input[3] = 12345
                """
            }
        }

        then {
            assert process.success
            firstRunTree = path(process.out.raw_tree.get(0)[1]).text
            assert firstRunTree != null && firstRunTree.length() > 0
        }
    }

    test("Should produce an identical treefile on a second, independent run with the same seed (determinism, part 2)") {

        when {
            process {
                """
                input[0] = tuple("H3N2", "whole_genome", file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true), "REF_A_Darwin_6_2021", file("${projectDir}/tests/data/phylo/phylo_segments.tsv", checkIfExists: true))
                input[1] = "GTR+G4"
                input[2] = 0
                input[3] = 12345
                """
            }
        }

        then {
            assert process.success
            def secondRunTree = path(process.out.raw_tree.get(0)[1]).text
            assert firstRunTree != null : "the first determinism test must run before this one"
            assert secondRunTree == firstRunTree : "IQ-TREE with a fixed seed should produce an identical treefile across independent runs"
        }
    }

    test("Should cap IQ-TREE threads at the available cores when more cpus are requested") {

        config "./PhyloTree_many_cpus.config"

        when {
            process {
                """
                input[0] = tuple("H3N2", "whole_genome", file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true), "REF_A_Darwin_6_2021", file("${projectDir}/tests/data/phylo/phylo_segments.tsv", checkIfExists: true))
                input[1] = "GTR+G4"
                input[2] = 0
                input[3] = 12345
                """
            }
        }

        then {
            assert process.success
            assert process.out.tree.size() == 1 : "the tree should still be built when more cpus are requested than cores exist"
            // the warning goes to the step log that ends up in phylo.log, not to the terminal
            assert path(process.out.step_log.get(0)[1]).text.contains("cpus requested but only")
            assert !process.stdout.join("\\n").contains("PhyloTree:") : "PhyloTree no longer prints step messages to the terminal"
        }
    }

    test("Should nest a segment tree's files under its own tree_folder (e.g. 'HA'), not 'whole_genome'") {

        when {
            process {
                """
                input[0] = tuple("H3N2_HA", "HA", file("${projectDir}/tests/data/phylo/phylo_alignment.fasta", checkIfExists: true), "REF_A_Darwin_6_2021", file("${projectDir}/tests/data/phylo/phylo_segments.tsv", checkIfExists: true))
                input[1] = "GTR+G4"
                input[2] = 0
                input[3] = 12345
                """
            }
        }

        then {
            assert process.success
            def treePath = path(process.out.tree.get(0)[1])
            assert treePath.toString().contains("/HA/") : "expected the tree nested under an 'HA' folder, got ${treePath}"
            assert treePath.getFileName().toString() == "phylo_tree.nwk"
            def forPostTree = process.out.for_post_tree.get(0)
            assert forPostTree[0] == "H3N2_HA"
            assert forPostTree[1] == "HA"
        }
    }

}
