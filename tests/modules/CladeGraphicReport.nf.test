nextflow_process {

    // Test file for the CladeGraphicReport process

    name "Test Process CladeGraphicReport"
    script "nf_pipeline/modules/CladeGraphicReport.nf"
    process "CladeGraphicReport"

    // Test 1: Verify the process creates correct HTML report when NO metadata is provided
    test("Should match the expected clade HTML report without the metadata file") {

        // When: Provide genotyping results CSV but EMPTY metadata array
        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/Graphs_test/final_genotyping_results.csv")
                input[1] = []
                """
            }
        }

        // Then: Verify the process succeeds and emits exactly one HTML report file
        then {
            // Check that the process executed successfully
            assert process.success

            // Get the emitted HTML report file(s) from the output channel
            def reportFiles = process.out[0]
            assert reportFiles != null : "Output channel is null. The HTML report was not emitted."
            assert reportFiles.size() == 1 : "Expected exactly one HTML report file to be emitted"

            // Convert the file path to a Path object for easier checking
            def htmlFile = path(reportFiles[0])
            // Verify that the HTML report file actually exists on disk
            assert htmlFile.exists() : "HTML report file was not created at expected location"
        }
    }
    // Test 2: Verify the process creates correct HTML report WHEN metadata IS provided
    test("Should match the expected clade HTML report with the metadata file") {

        // When: Provide BOTH genotyping results CSV AND metadata CSV
        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/Graphs_test/final_genotyping_results.csv")
                input[1] = file("${projectDir}/tests/data/Graphs_test/metadata.csv")
                """
            }
        }

        // Then: Verify the process succeeds and emits exactly two HTML report files
        then {
            assert process.success

            // Access the channels individually using their named emits
            def reportChannel = process.out.report
            def evolutionChannel = process.out.evolution_report

            assert reportChannel != null : "The main HTML report channel is null."
            assert evolutionChannel != null : "The evolution HTML report channel is null."

            def htmlFile = path(reportChannel[0])
            assert htmlFile.exists() : "Main HTML report file was not created at expected location"
            
            def evohtmlFile = path(evolutionChannel[0])
            assert evohtmlFile.exists() : "Evolution HTML report file was not created at expected location"
        }

    }

    // Test 3: Verify both reports offer a season RANGE (SEASON FROM / SEASON TO) and embed per-season data
    test("Should offer a season range selector with per-season data when the metadata spans several seasons") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/Graphs_test/final_genotyping_results.csv")
                input[1] = file("${projectDir}/tests/data/Graphs_seasons/metadata.csv")
                """
            }
        }

        then {
            assert process.success

            def pieHtml = path(process.out.report[0]).text
            def evoHtml = path(process.out.evolution_report[0]).text
            def seasons = ['2022-2023', '2023-2024', '2024-2025']

            [pie: pieHtml, evo: evoHtml].each { rt, html ->
                // The single season dropdown is replaced by SEASON FROM / SEASON TO
                assert html.contains("id=\"sel_season_from_${rt}\"") : "SEASON FROM select missing in the ${rt} report"
                assert html.contains("id=\"sel_season_to_${rt}\"") : "SEASON TO select missing in the ${rt} report"
                assert !html.contains("id=\"sel_season_${rt}\"") : "Old single season select still present in the ${rt} report"
                assert html.contains('>SEASON FROM</label>') && html.contains('>SEASON TO</label>')
                assert html.contains("id=\"sel_age_${rt}\"") && html.contains("id=\"sel_sex_${rt}\"")

                // FROM = All Time + seasons in chronological order, TO = seasons; the latest season is preselected in both
                def fromSel = (html =~ /(?s)<select id="sel_season_from_${rt}"[^>]*>(.*?)<\/select>/)[0][1]
                def toSel = (html =~ /(?s)<select id="sel_season_to_${rt}"[^>]*>(.*?)<\/select>/)[0][1]
                assert (fromSel =~ /value="([^"]+)"/).collect { it[1] } == ['All Time'] + seasons
                assert (toSel =~ /value="([^"]+)"/).collect { it[1] } == seasons
                assert fromSel.contains('<option value="2024-2025" selected>') && toSel.contains('<option value="2024-2025" selected>')

                // Titles for a range
                assert html.contains("'Seasons ' + r.from + ' to ' + r.to") : "Range title missing in the ${rt} report"
            }

            // Pie report: per-season sample counts are embedded so any range is summed in the page (Unknown Season kept for All Time)
            def recs = new groovy.json.JsonSlurper().parseText((pieHtml =~ /var pieRecords = (.*);/)[0][1])
            def perSeason = recs.groupBy { it[0] }.collectEntries { k, v -> [(k): v.sum { it[8] }] }
            assert perSeason == ['2022-2023': 12, '2023-2024': 12, '2024-2025': 12, 'Unknown Season': 2]
            assert (pieHtml =~ /var pieSeasons = (.*);/)[0][1] == '["2022-2023", "2023-2024", "2024-2025"]'

            // Evolution report: week span of every season, used for the From..To x-axis range
            assert evoHtml.contains('var seasonRanges = {"2022-2023": ["2022-10-03", "2023-10-01"], "2023-2024": ["2023-10-02", "2024-09-29"], "2024-2025": ["2024-09-30", "2025-09-28"]};')
        }
    }

}
